{
	"name": "React Sandbox Dev Container",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
	// Change name of the container
	"runArgs": ["--name", "dev-react-sandbox"],
	// Mount the .ssh repository to use GitHub
	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/dev/.ssh,readonly,type=bind"
	],
	"features": {
		"ghcr.io/devcontainers-extra/features/opencode:1": {}
	}
}
